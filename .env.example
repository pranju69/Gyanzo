# --- Database (Supabase PostgreSQL) ---
# Runtime connection — on Supabase use the TRANSACTION POOLER URI
# (Project Settings → Database → Connection string → Transaction pooler,
# port 6543) and append pgbouncer + connection_limit params:
#   postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=""
# Migrations / `prisma db push` need the DIRECT connection (port 5432,
# or the Session pooler URI) — used by DIRECT_URL only, never at runtime:
DIRECT_URL=""
# SANDBOX ONLY: set LOCAL_PG=1 to let src/instrumentation-node.ts boot a
# local user-space Postgres for development (see worklog / scripts).
# Leave unset everywhere else.
LOCAL_PG=""

# --- z-ai-web-dev-sdk (copied from the sandbox's /etc/.z-ai-config) ---
ZAI_BASE_URL=""
ZAI_API_KEY=""
ZAI_CHAT_ID=""
ZAI_TOKEN=""
ZAI_USER_ID=""

# --- Vercel Blob (PDF storage on serverless; auto-injected by Vercel
#     when you create a Blob store, leave empty for local disk mode) ---
BLOB_READ_WRITE_TOKEN=""

# Set to 1 on serverless hosts (no long-lived socket service available;
# the notification bell falls back to interval polling)
NEXT_PUBLIC_DISABLE_SOCKET=""

# --- Email verification delivery (Resend wins if both are configured) ---
# Resend: free account at resend.com → API Keys
RESEND_API_KEY=""
RESEND_FROM="Gyanzo <onboarding@resend.dev>"
# Classic SMTP (Gmail App Password, Brevo, Outlook, ...)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Google OAuth (custom credentials + email flow) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional override; defaults to <origin>/api/auth/google/callback.
# On Vercel set it to https://<your-app>.vercel.app/api/auth/google/callback
# and add the same URI in Google Cloud Console → Credentials.
GOOGLE_REDIRECT_URI=""
